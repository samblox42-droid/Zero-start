-- Sam's Music V6 - Final Clean Version (ohne X, ohne Sounds, mit Mülleimer)

local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local HttpService = game:GetService("HttpService")

if CoreGui:FindFirstChild("SamMusicV6") then
    CoreGui:FindFirstChild("SamMusicV6"):Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SamMusicV6"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = CoreGui

-- Auto Chat
task.spawn(function()
    task.wait(0.8)
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if channel then channel:SendAsync("⚡ Sam's Music V6 Loaded ⚡") end
        else
            local sayEvent = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            if sayEvent and sayEvent:FindFirstChild("SayMessageRequest") then
                sayEvent.SayMessageRequest:FireServer("⚡ Sam's Music V6 Loaded ⚡", "All")
            end
        end
    end)
end)

-- Main Frame
local Main = Instance.new("Frame")
Main.Size = UDim2.new(0, 400, 0, 300)
Main.Position = UDim2.new(0.5, -200, 0.5, -150)
Main.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
Main.Parent = ScreenGui
Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 10)

local Stroke = Instance.new("UIStroke")
Stroke.Color = Color3.fromRGB(0, 255, 120)
Stroke.Thickness = 1.6
Stroke.Parent = Main

-- Particle Background
local ParticleFrame = Instance.new("Frame")
ParticleFrame.Size = UDim2.new(1,0,1,0)
ParticleFrame.BackgroundTransparency = 1
ParticleFrame.ClipsDescendants = true
ParticleFrame.ZIndex = 0
ParticleFrame.Parent = Main
Instance.new("UICorner", ParticleFrame).CornerRadius = UDim.new(0,10)

task.spawn(function()
    while task.wait(0.4) do
        if not ParticleFrame.Parent then break end
        local p = Instance.new("Frame")
        local s = math.random(2,4)
        p.Size = UDim2.new(0,s,0,s)
        p.Position = UDim2.new(math.random(),0,1,0)
        p.BackgroundColor3 = Color3.fromRGB(50,255,100)
        p.BackgroundTransparency = 0.6
        p.BorderSizePixel = 0
        Instance.new("UICorner", p).CornerRadius = UDim.new(1,0)
        p.Parent = ParticleFrame
        TweenService:Create(p, TweenInfo.new(math.random(4,7), Enum.EasingStyle.Linear), {
            Position = UDim2.new(p.Position.X.Scale + (math.random(-10,10)/100),0,-0.1,0),
            BackgroundTransparency = 1
        }):Play()
        task.delay(8, function() p:Destroy() end)
    end
end)

