-- Sam's Music V6 - Clean Version (nur optisch verbessert + Dark/Light Mode)

local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local HttpService = game:GetService("HttpService")

if CoreGui:FindFirstChild("SamMusicV6") then
    CoreGui:FindFirstChild("SamMusicV6"):Destroy()
end

-- ===================== THEME =====================
local Themes = {
    Dark = {
        Bg          = Color3.fromRGB(14, 14, 18),
        Secondary   = Color3.fromRGB(22, 22, 28),
        Content     = Color3.fromRGB(18, 18, 24),
        Button      = Color3.fromRGB(30, 30, 38),
        ButtonHover = Color3.fromRGB(40, 40, 50),
        Accent      = Color3.fromRGB(0, 255, 130),
        Text        = Color3.fromRGB(235, 235, 245),
        TextDark    = Color3.fromRGB(140, 140, 155),
        Danger      = Color3.fromRGB(255, 55, 55),
        Stroke      = Color3.fromRGB(0, 255, 130),
    },
    Light = {
        Bg          = Color3.fromRGB(245, 245, 248),
        Secondary   = Color3.fromRGB(230, 230, 236),
        Content     = Color3.fromRGB(255, 255, 255),
        Button      = Color3.fromRGB(220, 220, 228),
        ButtonHover = Color3.fromRGB(205, 205, 215),
        Accent      = Color3.fromRGB(0, 170, 90),
        Text        = Color3.fromRGB(25, 25, 30),
        TextDark    = Color3.fromRGB(90, 90, 105),
        Danger      = Color3.fromRGB(220, 50, 50),
        Stroke      = Color3.fromRGB(0, 170, 90),
    }
}

local CurrentTheme = "Dark"
local Theme = Themes.Dark

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SamMusicV6"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = CoreGui

-- Auto Chat
task.spawn(function()
    task.wait(0.8)
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if channel then channel:SendAsync("⚡ Sam's Music V6 Loaded ⚡") end
        else
            local sayEvent = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            if sayEvent and sayEvent:FindFirstChild("SayMessageRequest") then
                sayEvent.SayMessageRequest:FireServer("⚡ Sam's Music V6 Loaded ⚡", "All")
            end
        end
    end)
end)

-- Main Frame
local Main = Instance.new("Frame")
Main.Size = UDim2.new(0, 410, 0, 310)
Main.Position = UDim2.new(0.5, -205, 0.5, -155)
Main.BackgroundColor3 = Theme.Bg
Main.Parent = ScreenGui
Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 12)

local Stroke = Instance.new("UIStroke")
Stroke.Color = Theme.Stroke
Stroke.Thickness = 1.5
Stroke.Transparency = 0.4
Stroke.Parent = Main

-- Particle Background
local ParticleFrame = Instance.new("Frame")
ParticleFrame.Size = UDim2.new(1,0,1,0)
ParticleFrame.BackgroundTransparency = 1
ParticleFrame.ClipsDescendants = true
ParticleFrame.ZIndex = 0
ParticleFrame.Parent = Main
Instance.new("UICorner", ParticleFrame).CornerRadius = UDim.new(0,12)

task.spawn(function()
    while task.wait(0.45) do
        if not ParticleFrame.Parent then break end
        local p = Instance.new("Frame")
        local s = math.random(2,4)
        p.Size = UDim2.new(0,s,0,s)
        p.Position = UDim2.new(math.random(),0,1,0)
        p.BackgroundColor3 = Theme.Accent
        p.BackgroundTransparency = 0.55
        p.BorderSizePixel = 0
        Instance.new("UICorner", p).CornerRadius = UDim.new(1,0)
        p.Parent = ParticleFrame
        TweenService:Create(p, TweenInfo.new(math.random(4,7), Enum.EasingStyle.Linear), {
            Position = UDim2.new(p.Position.X.Scale + (math.random(-10,10)/100),0,-0.1,0),
            BackgroundTransparency = 1
        }):Play()
        task.delay(8, function() p:Destroy() end)
    end
end)

