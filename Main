local function buildMusicTab(page, songList)
    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1,0,1,-8)
    scroll.Position = UDim2.new(0,0,0,4)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 3
    scroll.Parent = page
    Instance.new("UIListLayout", scroll).Padding = UDim.new(0,5)

    for _, song in ipairs(songList) do
        local entry = Instance.new("Frame")
        entry.Size = UDim2.new(1,-4,0,30)
        entry.BackgroundColor3 = Theme.Button
        entry.Parent = scroll
        Instance.new("UICorner", entry).CornerRadius = UDim.new(0,6)

        local namelbl = Instance.new("TextLabel")
        namelbl.Size = UDim2.new(0.58,0,1,0)
        namelbl.Position = UDim2.new(0,8,0,0)
        namelbl.BackgroundTransparency = 1
        namelbl.Text = song[1]
        namelbl.TextColor3 = Theme.Text
        namelbl.Font = Enum.Font.Gotham
        namelbl.TextSize = 11
        namelbl.TextXAlignment = Enum.TextXAlignment.Left
        namelbl.Parent = entry

        local play = Instance.new("TextButton")
        play.Size = UDim2.new(0,24,0,20)
        play.Position = UDim2.new(1,-56,0.5,-10)
        play.BackgroundColor3 = Color3.fromRGB(0,150,50)
        play.Text = "▶"
        play.TextColor3 = Color3.new(1,1,1)
        play.Font = Enum.Font.GothamBold
        play.TextSize = 11
        play.Parent = entry
        Instance.new("UICorner", play).CornerRadius = UDim.new(0,5)
        clickAnim(play)
        play.MouseButton1Click:Connect(function()
            SmartPlayMusic(tostring(song[2]), SelectedVehicle, false)
        end)

        local save = Instance.new("TextButton")
        save.Size = UDim2.new(0,24,0,20)
        save.Position = UDim2.new(1,-28,0.5,-10)
        save.BackgroundColor3 = Color3.fromRGB(255,165,0)
        save.Text = "💾"
        save.TextColor3 = Color3.new(1,1,1)
        save.Font = Enum.Font.GothamBold
        save.TextSize = 11
        save.Parent = entry
        Instance.new("UICorner", save).CornerRadius = UDim.new(0,5)
        clickAnim(save)
        save.MouseButton1Click:Connect(function()
            if #SavedPlaylist < MaxSavedSongs then
                table.insert(SavedPlaylist, {name = song[1], id = tostring(song[2])})
                SavePlaylistToFile()
                buildSavedUI(SavedPage)
            end
        end)
    end
    scroll.CanvasSize = UDim2.new(0,0,0, #songList * 35)
end

buildMusicTab(HitsPage, HitsSongs)

-- Saved Tab
function buildSavedUI(page)
    for _, c in pairs(page:GetChildren()) do
        if c:IsA("Frame") or c:IsA("ScrollingFrame") or c:IsA("TextLabel") then c:Destroy() end
    end

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1,0,0,22)
    title.Position = UDim2.new(0,0,0,4)
    title.BackgroundTransparency = 1
    title.Text = "📁 Saved Songs (" .. #SavedPlaylist .. "/" .. MaxSavedSongs .. ")"
    title.TextColor3 = Theme.Accent
    title.Font = Enum.Font.GothamBold
    title.TextSize = 12
    title.Parent = page

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1,0,1,-30)
    scroll.Position = UDim2.new(0,0,0,28)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 3
    scroll.Parent = page
    Instance.new("UIListLayout", scroll).Padding = UDim.new(0,5)

    if #SavedPlaylist == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1,0,0,45)
        empty.BackgroundTransparency = 1
        empty.Text = "No saved songs yet!\nClick 💾 in HITS"
        empty.TextColor3 = Theme.TextDark
        empty.Font = Enum.Font.Gotham
        empty.TextSize = 11
        empty.TextWrapped = true
        empty.Parent = scroll
        return
    end

    for i, song in ipairs(SavedPlaylist) do
        local entry = Instance.new("Frame")
        entry.Size = UDim2.new(1,-4,0,30)
        entry.BackgroundColor3 = Theme.Button
        entry.Parent = scroll
        Instance.new("UICorner", entry).CornerRadius = UDim.new(0,6)

        local namelbl = Instance.new("TextLabel")
        namelbl.Size = UDim2.new(0.5,0,1,0)
        namelbl.Position = UDim2.new(0,6,0,0)
        namelbl.BackgroundTransparency = 1
        namelbl.Text = song.name
        namelbl.TextColor3 = Theme.Text
        namelbl.Font = Enum.Font.Gotham
        namelbl.TextSize = 11
        namelbl.TextXAlignment = Enum.TextXAlignment.Left
        namelbl.Parent = entry

        local play = Instance.new("TextButton")
        play.Size = UDim2.new(0,24,0,20)
        play.Position = UDim2.new(1,-56,0.5,-10)
        play.BackgroundColor3 = Color3.fromRGB(0,150,50)
        play.Text = "▶"
        play.TextColor3 = Color3.new(1,1,1)
        play.Font = Enum.Font.GothamBold
        play.TextSize = 11
        play.Parent = entry
        Instance.new("UICorner", play).CornerRadius = UDim.new(0,5)
        clickAnim(play)
        play.MouseButton1Click:Connect(function()
            SmartPlayMusic(song.id, SelectedVehicle, false)
        end)

        local deleteBtn = Instance.new("TextButton")
        deleteBtn.Size = UDim2.new(0,24,0,20)
        deleteBtn.Position = UDim2.new(1,-28,0.5,-10)
        deleteBtn.BackgroundColor3 = Theme.Danger
        deleteBtn.Text = "✕"
        deleteBtn.TextColor3 = Color3.new(1,1,1)
        deleteBtn.Font = Enum.Font.GothamBold
        deleteBtn.TextSize = 12
        deleteBtn.Parent = entry
        Instance.new("UICorner", deleteBtn).CornerRadius = UDim.new(0,5)
        clickAnim(deleteBtn)

        deleteBtn.MouseButton1Click:Connect(function()
            table.remove(SavedPlaylist, i)
            SavePlaylistToFile()
            buildSavedUI(page)
        end)
    end
    scroll.CanvasSize = UDim2.new(0,0,0,#SavedPlaylist*35)
end

buildSavedUI(SavedPage)

-- Update Tab (hier ist der Theme-Switch)
local function buildUpdateUI(page)
    for _, c in pairs(page:GetChildren()) do
        c:Destroy()
    end

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1,0,0,28)
    title.Position = UDim2.new(0,6,0,6)
    title.BackgroundTransparency = 1
    title.Text = "V6 Update Log"
    title.TextColor3 = Theme.Accent
    title.Font = Enum.Font.GothamBlack
    title.TextSize = 15
    title.Parent = page

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1,-12,0,90)
    text.Position = UDim2.new(0,6,0,40)
    text.BackgroundTransparency = 1
    text.Text = "• Updated to Version 6\n• Added 5 new songs to HITS\n• Dark / Light Mode\n• Bessere Optik"
    text.TextColor3 = Theme.Text
    text.Font = Enum.Font.Gotham
    text.TextSize = 12
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.TextYAlignment = Enum.TextYAlignment.Top
    text.TextWrapped = true
    text.Parent = page

    -- Theme Switch Button
    local themeBtn = Instance.new("TextButton")
    themeBtn.Size = UDim2.new(1,-12,0,34)
    themeBtn.Position = UDim2.new(0,6,0,145)
    themeBtn.BackgroundColor3 = Theme.Button
    themeBtn.Text = CurrentTheme == "Dark" and "🌙  Dark Mode  →  Light" or "☀️  Light Mode  →  Dark"
    themeBtn.TextColor3 = Theme.Text
    themeBtn.Font = Enum.Font.GothamBold
    themeBtn.TextSize = 13
    themeBtn.Parent = page
    Instance.new("UICorner", themeBtn).CornerRadius = UDim.new(0,8)
    clickAnim(themeBtn)

    themeBtn.MouseButton1Click:Connect(function()
        CurrentTheme = CurrentTheme == "Dark" and "Light" or "Dark"
        ApplyTheme()
        buildUpdateUI(page)
        buildSavedUI(SavedPage)
        -- Hits und Vehicle behalten ihre Farben über Theme
    end)
end

buildUpdateUI(UpdatePage)

