    Main.Visible = true
    MinIcon.Visible = false
end)

-- Header
local Header = Instance.new("Frame")
Header.Size = UDim2.new(1,0,0,34)
Header.BackgroundTransparency = 1
Header.Parent = Main

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(0.75,0,1,0)
Title.Position = UDim2.new(0,14,0,0)
Title.BackgroundTransparency = 1
Title.Text = "Sam's Music V6 | " .. LocalPlayer.Name
Title.TextColor3 = Theme.Text
Title.Font = Enum.Font.GothamBlack
Title.TextSize = 13
Title.TextXAlignment = Enum.TextXAlignment.Left
Title.Parent = Header

-- Drag
local dragging, dragInput, dragStart, startPos
Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)
Header.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

local function clickAnim(btn)
    local orig = btn.Size
    btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(orig.X.Scale, orig.X.Offset-2, orig.Y.Scale, orig.Y.Offset-2)}):Play()
        end
    end)
    btn.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            TweenService:Create(btn, TweenInfo.new(0.1), {Size = orig}):Play()
        end
    end)
end

-- Tab System (untereinander)
local TabButtons = Instance.new("Frame")
TabButtons.Size = UDim2.new(0,108,1,-46)
TabButtons.Position = UDim2.new(0,8,0,38)
TabButtons.BackgroundTransparency = 1
TabButtons.Parent = Main

local TabLayout = Instance.new("UIListLayout")
TabLayout.Padding = UDim.new(0,7)
TabLayout.SortOrder = Enum.SortOrder.LayoutOrder
TabLayout.Parent = TabButtons

local ContentArea = Instance.new("Frame")
ContentArea.Size = UDim2.new(1,-128,1,-46)
ContentArea.Position = UDim2.new(0,122,0,38)
ContentArea.BackgroundColor3 = Theme.Content
ContentArea.Parent = Main
Instance.new("UICorner", ContentArea).CornerRadius = UDim.new(0,10)

local activePage = nil
local TabBtnRefs = {}

local function createTab(name, isFirst)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1,0,0,28)
    Btn.BackgroundColor3 = Theme.Button
    Btn.BackgroundTransparency = isFirst and 0 or 1
    Btn.Text = name
    Btn.TextColor3 = isFirst and Theme.Accent or Theme.TextDark
    Btn.Font = Enum.Font.GothamSemibold
    Btn.TextSize = 11
    Btn.Parent = TabButtons
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0,6)
    clickAnim(Btn)
    TabBtnRefs[name] = Btn

    local Page = Instance.new("Frame")
    Page.Size = UDim2.new(1,-16,1,-12)
    Page.Position = UDim2.new(0,8,0,6)
    Page.BackgroundTransparency = 1
    Page.Visible = isFirst
    Page.Parent = ContentArea

    if isFirst then activePage = Page end

    Btn.MouseButton1Click:Connect(function()
        if activePage == Page then return end
        for _, c in pairs(ContentArea:GetChildren()) do
            if c:IsA("Frame") then c.Visible = false end
        end
        for _, b in pairs(TabButtons:GetChildren()) do
            if b:IsA("TextButton") then
                TweenService:Create(b, TweenInfo.new(0.18), {
                    BackgroundTransparency = 1,
                    TextColor3 = Theme.TextDark
                }):Play()
            end
        end
        TweenService:Create(Btn, TweenInfo.new(0.18), {
            BackgroundTransparency = 0,
            TextColor3 = Theme.Accent
        }):Play()
        Page.Visible = true
        activePage = Page
    end)

    return Page
end

local VehiclePage = createTab("Vehicle", true)
local HitsPage    = createTab("HITS", false)
local SavedPage   = createTab("SAVED", false)
local UpdatePage  = createTab("UPDATE", false)
local CreditsPage = createTab("CREDITS", false)

-- ===================== THEME APPLY =====================
local function ApplyTheme()
    Theme = Themes[CurrentTheme]
    Main.BackgroundColor3 = Theme.Bg
    ContentArea.BackgroundColor3 = Theme.Content
    Stroke.Color = Theme.Stroke
    Title.TextColor3 = Theme.Text
    MinIcon.BackgroundColor3 = Theme.Accent

    for name, btn in pairs(TabBtnRefs) do
        if btn.BackgroundTransparency < 0.5 then
            btn.BackgroundColor3 = Theme.Button
            btn.TextColor3 = Theme.Accent
        else
            btn.TextColor3 = Theme.TextDark
        end
    end
end

-- ==================== BACKEND (UNVERÄNDERT) ====================
local RE = ReplicatedStorage:FindFirstChild("RE") or ReplicatedStorage:WaitForChild("RE", 5)
local VehicleRemote = RE and RE:FindFirstChild("1NoMoto1rVehicle1s")
local ClearRemote = RE and RE:FindFirstChild("1Clea1rTool1s")

local RGBEnabled = false
local SelectedVehicle = "SegwaySmall"

local SavedPlaylist = {}
local MaxSavedSongs = 30
local SaveFileName = "SamMusicV6_Playlist.json"

local function LoadSavedPlaylist()
    pcall(function()
        if readfile and isfile and isfile(SaveFileName) then
            SavedPlaylist = HttpService:JSONDecode(readfile(SaveFileName)) or {}
        end
    end)
end

local function SavePlaylistToFile()
    pcall(function()
        if writefile then
            writefile(SaveFileName, HttpService:JSONEncode(SavedPlaylist))
        end
    end)
end

LoadSavedPlaylist()

local function SmartPlayMusic(id, vehicleType, useRGB)
    if not VehicleRemote then return end
    task.spawn(function()
        RGBEnabled = false
        VehicleRemote:FireServer("Delete NoMotorVehicle")
        task.wait(0.2)
        if ClearRemote then ClearRemote:FireServer("ClearAllTools") end
        task.wait(0.2)
        VehicleRemote:FireServer(vehicleType)
        task.wait(1.0)
        if useRGB then
            RGBEnabled = true
            task.spawn(function()
                while RGBEnabled and task.wait(0.1) do
                    local c = Color3.fromHSV(tick() % 5 / 5, 1, 1)
                    local car = RE:FindFirstChild("1Player1sCa1r")
                    if car then car:FireServer("NoMotorColor", c) end
                end
            end)
        end
        VehicleRemote:FireServer("PickingScooterMusicText", tostring(id))
        task.wait(0.1)
        VehicleRemote:FireServer("PickingScooterMusicText", tonumber(id))
    end)
end

local function StopMusic()
    RGBEnabled = false
    if VehicleRemote then VehicleRemote:FireServer("Delete NoMotorVehicle") end
    if ClearRemote then task.spawn(function() task.wait(0.1) ClearRemote:FireServer("ClearAllTools") end) end
end

-- Vehicle Tab
local function buildVehicleUI(page)
    local IDBox = Instance.new("TextBox")
    IDBox.Size = UDim2.new(1,0,0,26)
    IDBox.Position = UDim2.new(0,0,0,4)
    IDBox.BackgroundColor3 = Theme.Button
    IDBox.PlaceholderText = "Enter Audio ID..."
    IDBox.Text = ""
    IDBox.TextColor3 = Theme.Text
    IDBox.Font = Enum.Font.Gotham
    IDBox.TextSize = 12
    IDBox.Parent = page
    Instance.new("UICorner", IDBox).CornerRadius = UDim.new(0,6)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,0,0,18)
    lbl.Position = UDim2.new(0,0,0,36)
    lbl.BackgroundTransparency = 1
    lbl.Text = "Select Vehicle:"
    lbl.TextColor3 = Theme.TextDark
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 11
    lbl.Parent = page

    local skate = Instance.new("TextButton")
    skate.Size = UDim2.new(0.48,0,0,24)
    skate.Position = UDim2.new(0,0,0,58)
    skate.BackgroundColor3 = Color3.fromRGB(0,180,80)
    skate.Text = "Skateboard"
    skate.TextColor3 = Color3.new(1,1,1)
    skate.Font = Enum.Font.GothamBold
    skate.TextSize = 10
    skate.Parent = page
    Instance.new("UICorner", skate).CornerRadius = UDim.new(0,6)

    local hover = Instance.new("TextButton")
    hover.Size = UDim2.new(0.48,0,0,24)
    hover.Position = UDim2.new(0.52,0,0,58)
    hover.BackgroundColor3 = Theme.Button
    hover.Text = "Hoverboard"
    hover.TextColor3 = Theme.Text
    hover.Font = Enum.Font.GothamBold
    hover.TextSize = 10
    hover.Parent = page
    Instance.new("UICorner", hover).CornerRadius = UDim.new(0,6)

    skate.MouseButton1Click:Connect(function()
        SelectedVehicle = "SkateBoard"
        skate.BackgroundColor3 = Color3.fromRGB(0,180,80)
        hover.BackgroundColor3 = Theme.Button
    end)
    hover.MouseButton1Click:Connect(function()
        SelectedVehicle = "SegwaySmall"
        hover.BackgroundColor3 = Color3.fromRGB(0,180,80)
        skate.BackgroundColor3 = Theme.Button
    end)

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1,0,1,-90)
    scroll.Position = UDim2.new(0,0,0,88)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 3
    scroll.Parent = page
    Instance.new("UIListLayout", scroll).Padding = UDim.new(0,5)

    local function makeBtn(text, color, rgb)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1,-4,0,26)
        b.BackgroundColor3 = color
        b.Text = text
        b.TextColor3 = Color3.new(1,1,1)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 11
        b.Parent = scroll
        Instance.new("UICorner", b).CornerRadius = UDim.new(0,6)
        clickAnim(b)
        b.MouseButton1Click:Connect(function()
            SmartPlayMusic(IDBox.Text, SelectedVehicle, rgb)
        end)
    end

    makeBtn("Play Music", Color3.fromRGB(0,120,255), false)
    makeBtn("Play with RGB", Color3.fromRGB(150,50,255), true)

    local stop = Instance.new("TextButton")
    stop.Size = UDim2.new(1,-4,0,26)
    stop.BackgroundColor3 = Theme.Danger
    stop.Text = "Stop Music"
    stop.TextColor3 = Color3.new(1,1,1)
    stop.Font = Enum.Font.GothamBold
    stop.TextSize = 11
    stop.Parent = scroll
    Instance.new("UICorner", stop).CornerRadius = UDim.new(0,6)
    clickAnim(stop)
    stop.MouseButton1Click:Connect(StopMusic)

    scroll.CanvasSize = UDim2.new(0,0,0,110)
end

buildVehicleUI(VehiclePage)

