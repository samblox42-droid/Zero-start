    t.Parent = page

    local l1 = Instance.new("TextLabel")
    l1.Size = UDim2.new(1,-20,0,22) l1.Position = UDim2.new(0,10,0,50)
    l1.BackgroundTransparency = 1
    l1.Text = "SamBlox (Iostein_cool) Hub manufacturer/script"
    l1.TextColor3 = Color3.fromRGB(200,200,220) l1.Font = Enum.Font.Gotham l1.TextSize = 11
    l1.TextXAlignment = Enum.TextXAlignment.Left l1.TextWrapped = true l1.Parent = page

    local l2 = Instance.new("TextLabel")
    l2.Size = UDim2.new(1,-20,0,22) l2.Position = UDim2.new(0,10,0,74)
    l2.BackgroundTransparency = 1
    l2.Text = "Rosti (Rostam7486) SamBlox's best friend"
