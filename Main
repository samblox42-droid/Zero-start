local function buildMusicTab(page, songList)
    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1,0,1,-10) scroll.Position = UDim2.new(0,0,0,5)
    scroll.BackgroundTransparency = 1 scroll.ScrollBarThickness = 3 scroll.Parent = page
    Instance.new("UIListLayout", scroll).Padding = UDim.new(0,4)

    for _, song in ipairs(songList) do
        local entry = Instance.new("Frame")
        entry.Size = UDim2.new(1,-5,0,28)
        entry.BackgroundColor3 = Color3.fromRGB(30,30,40)
        entry.Parent = scroll
        Instance.new("UICorner", entry).CornerRadius = UDim.new(0,4)

        local namelbl = Instance.new("TextLabel")
        namelbl.Size = UDim2.new(0.6,0,1,0) namelbl.Position = UDim2.new(0,8,0,0)
        namelbl.BackgroundTransparency = 1 namelbl.Text = song[1]
        namelbl.TextColor3 = Color3.fromRGB(200,200,220) namelbl.Font = Enum.Font.Gotham
        namelbl.TextSize = 10 namelbl.TextXAlignment = Enum.TextXAlignment.Left
        namelbl.Parent = entry

        local play = Instance.new("TextButton")
        play.Size = UDim2.new(0,22,0,18) play.Position = UDim2.new(1,-52,0.5,-9)
        play.BackgroundColor3 = Color3.fromRGB(0,150,50) play.Text = "▶"
        play.TextColor3 = Color3.new(1,1,1) play.Font = Enum.Font.GothamBold play.TextSize = 10
        play.Parent = entry Instance.new("UICorner", play).CornerRadius = UDim.new(0,4)
        clickAnim(play)
        play.MouseButton1Click:Connect(function()
            SmartPlayMusic(tostring(song[2]), SelectedVehicle, false)
        end)

        local save = Instance.new("TextButton")
        save.Size = UDim2.new(0,22,0,18) save.Position = UDim2.new(1,-28,0.5,-9)
        save.BackgroundColor3 = Color3.fromRGB(255,165,0) save.Text = "💾"
        save.TextColor3 = Color3.new(1,1,1) save.Font = Enum.Font.GothamBold save.TextSize = 10
        save.Parent = entry Instance.new("UICorner", save).CornerRadius = UDim.new(0,4)
        clickAnim(save)
        save.MouseButton1Click:Connect(function()
            if #SavedPlaylist < MaxSavedSongs then
                table.insert(SavedPlaylist, {name = song[1], id = tostring(song[2])})
                SavePlaylistToFile()
                buildSavedUI(SavedPage)
            end
        end)
    end
    scroll.CanvasSize = UDim2.new(0,0,0, #songList * 32)
end

buildMusicTab(HitsPage, HitsSongs)

-- Saved Tab mit Mülleimer
function buildSavedUI(page)
    for _, c in pairs(page:GetChildren()) do
        if c:IsA("Frame") or c:IsA("ScrollingFrame") then c:Destroy() end
    end

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1,0,0,20) title.Position = UDim2.new(0,0,0,5)
    title.BackgroundTransparency = 1
    title.Text = "📁 Saved Songs (" .. #SavedPlaylist .. "/" .. MaxSavedSongs .. ")"
    title.TextColor3 = Color3.fromRGB(0,255,120)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 11
    title.Parent = page

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1,0,1,-30) scroll.Position = UDim2.new(0,0,0,30)
    scroll.BackgroundTransparency = 1 scroll.ScrollBarThickness = 3 scroll.Parent = page
    Instance.new("UIListLayout", scroll).Padding = UDim.new(0,4)

    if #SavedPlaylist == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1,0,0,40) empty.BackgroundTransparency = 1
        empty.Text = "No saved songs yet!\nClick 💾 in HITS"
        empty.TextColor3 = Color3.fromRGB(150,150,150) empty.Font = Enum.Font.Gotham
        empty.TextSize = 10 empty.TextWrapped = true empty.Parent = scroll
        return
    end

    for i, song in ipairs(SavedPlaylist) do
        local entry = Instance.new("Frame")
        entry.Size = UDim2.new(1,-5,0,28)
        entry.BackgroundColor3 = Color3.fromRGB(30,30,40)
        entry.Parent = scroll
        Instance.new("UICorner", entry).CornerRadius = UDim.new(0,4)

        local namelbl = Instance.new("TextLabel")
        namelbl.Size = UDim2.new(0.5,0,1,0) namelbl.Position = UDim2.new(0,5,0,0)
        namelbl.BackgroundTransparency = 1 namelbl.Text = song.name
        namelbl.TextColor3 = Color3.fromRGB(200,200,220) namelbl.Font = Enum.Font.Gotham
        namelbl.TextSize = 9 namelbl.TextXAlignment = Enum.TextXAlignment.Left
        namelbl.Parent = entry

        local play = Instance.new("TextButton")
        play.Size = UDim2.new(0,22,0,18) play.Position = UDim2.new(1,-52,0.5,-9)
        play.BackgroundColor3 = Color3.fromRGB(0,150,50) play.Text = "▶"
        play.TextColor3 = Color3.new(1,1,1) play.Font = Enum.Font.GothamBold play.TextSize = 10
        play.Parent = entry Instance.new("UICorner", play).CornerRadius = UDim.new(0,4)
        clickAnim(play)
        play.MouseButton1Click:Connect(function()
            SmartPlayMusic(song.id, SelectedVehicle, false)
        end)

        -- Roter Mülleimer
        local deleteBtn = Instance.new("TextButton")
        deleteBtn.Size = UDim2.new(0,22,0,18) deleteBtn.Position = UDim2.new(1,-28,0.5,-9)
        deleteBtn.BackgroundColor3 = Color3.fromRGB(255,60,60)
        deleteBtn.Text = "✕"
        deleteBtn.TextColor3 = Color3.new(1,1,1)
        deleteBtn.Font = Enum.Font.GothamBold
        deleteBtn.TextSize = 12
        deleteBtn.Parent = entry
        Instance.new("UICorner", deleteBtn).CornerRadius = UDim.new(0,4)
        clickAnim(deleteBtn)

        deleteBtn.MouseButton1Click:Connect(function()
            table.remove(SavedPlaylist, i)
            SavePlaylistToFile()
            buildSavedUI(page)
        end)
    end
    scroll.CanvasSize = UDim2.new(0,0,0,#SavedPlaylist*32)
end

buildSavedUI(SavedPage)

