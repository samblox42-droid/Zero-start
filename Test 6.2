local FullSnowFrame = Instance.new("Frame")
FullSnowFrame.Name = "FullScreenSnow"
FullSnowFrame.Size = UDim2.new(1, 0, 1, 0)
FullSnowFrame.Position = UDim2.new(0, 0, 0, 0)
