local activePage = nil
local TabBtnRefs = {}

local function createTab(name, icon, isFirst)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 32)
    Btn.BackgroundColor3 = isFirst and Color3.fromRGB(0, 180, 90) or Theme.Button
    Btn.BackgroundTransparency = isFirst and 0 or 0.12
    Btn.Text = icon .. "  " .. name
    Btn.TextColor3 = isFirst and Color3.new(1,1,1) or Theme.TextDark
    Btn.Font = Enum.Font.GothamBold
    Btn.TextSize = 12
    Btn.ZIndex = 4
    Btn.Parent = TabButtons
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)

    -- Snow accent on tab
    local snow = Instance.new("TextLabel")
    snow.Size = UDim2.new(0, 14, 0, 14)
    snow.Position = UDim2.new(1, -18, 0.5, -7)
    snow.BackgroundTransparency = 1
    snow.Text = "❄"
    snow.TextSize = 11
    snow.TextColor3 = Color3.fromRGB(180, 220, 255)
    snow.ZIndex = 5
    snow.Parent = Btn

    -- Green glow for active
    if isFirst then
        local glow = Instance.new("UIStroke")
        glow.Color = Color3.fromRGB(0, 255, 140)
        glow.Thickness = 1.5
        glow.Transparency = 0.3
        glow.Parent = Btn
    end

    clickAnim(Btn)
    TabBtnRefs[name] = Btn

    local Page = Instance.new("Frame")
    Page.Size = UDim2.new(1, -16, 1, -12)
    Page.Position = UDim2.new(0, 8, 0, 6)
    Page.BackgroundTransparency = 1
    Page.Visible = isFirst
    Page.ZIndex = 3
    Page.Parent = ContentArea

    if isFirst then activePage = Page end

    Btn.MouseButton1Click:Connect(function()
        if activePage == Page then return end
        for _, c in pairs(ContentArea:GetChildren()) do
            if c:IsA("Frame") then c.Visible = false end
        end
        for _, b in pairs(TabButtons:GetChildren()) do
            if b:IsA("TextButton") then
                TweenService:Create(b, TweenInfo.new(0.18), {
                    BackgroundColor3 = Theme.Button,
                    BackgroundTransparency = 0.12,
                    TextColor3 = Theme.TextDark
                }):Play()
                local s = b:FindFirstChildOfClass("UIStroke")
                if s then s:Destroy() end
            end
        end
        TweenService:Create(Btn, TweenInfo.new(0.18), {
            BackgroundColor3 = Color3.fromRGB(0, 180, 90),
            BackgroundTransparency = 0,
            TextColor3 = Color3.new(1,1,1)
        }):Play()
        local newGlow = Instance.new("UIStroke")
        newGlow.Color = Color3.fromRGB(0, 255, 140)
        newGlow.Thickness = 1.5
        newGlow.Transparency = 0.3
        newGlow.Parent = Btn
        Page.Visible = true
        activePage = Page
    end)

    return Page
end

