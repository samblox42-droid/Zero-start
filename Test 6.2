local snowActive = true
local snowflakes = {}

local function createSnowflake()
    if not snowActive or not FullSnowFrame.Parent then return end
    local flake = Instance.new("TextLabel")
    local size = math.random(10, 22)
    flake.Size = UDim2.new(0, size, 0, size)
    flake.Position = UDim2.new(math.random(), 0, -0.05, 0)
    flake.BackgroundTransparency = 1
    flake.Text = ({"❄", "❅", "❆", "✦", "✧"})[math.random(1, 5)]
    flake.TextColor3 = Color3.fromRGB(200 + math.random(0, 40), 230 + math.random(0, 20), 255)
    flake.TextTransparency = math.random(15, 50) / 100
    flake.TextSize = size - 2
    flake.Font = Enum.Font.GothamBold
    flake.ZIndex = 1
    flake.Parent = FullSnowFrame
    table.insert(snowflakes, flake)

    local duration = math.random(7, 14)
    local sideMove = (math.random() - 0.5) * 0.25
    TweenService:Create(flake, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Position = UDim2.new(flake.Position.X.Scale + sideMove, 0, 1.1, 0),
        TextTransparency = 1,
        Rotation = math.random(-40, 40)
    }):Play()

    task.delay(duration + 0.5, function()
        if flake and flake.Parent then flake:Destroy() end
    end)
end

task.spawn(function()
    while ScreenGui.Parent do
        if snowActive and Main and Main.Visible then
            createSnowflake()
            if math.random() > 0.6 then createSnowflake() end
        end
        task.wait(0.18)
    end
end)

